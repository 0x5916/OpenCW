# ============================================================================
#  Forum API test cases — OpenCW backend
#
#  Requires : VS Code "REST Client" extension (humao.rest-client)
#  Env file : ../http-client.env.json  (select "local" with Rest Client: Switch Environment)
#
#  HOW TO RUN
#    1. Start server + DB and seed a category/thread/post (see http/README.md).
#    2. Run top-to-bottom. Requests 0.1 / 0.2 populate {{accessToken}} for the
#       authenticated requests below — run them FIRST each session.
#    3. Use the "Send Request" code lens next to each request.
#
#  NOTES
#    - GET /v1/forum/* listing endpoints are PUBLIC (no auth).
#    - POST /v1/forum/threads and POST /v1/forum/threads/:id/posts are AUTHENTICATED
#      and return 201 when creation succeeds.
#    - `categoryId` / `threadId` live in the environment file; the values below
#      match the seed data in http/README.md.
# ============================================================================
#  4. Thread detail and creation (authenticated for creation)
### 0.0 Health check (server up?)

### 4.0 Get thread detail (public)
GET {{baseUrl}}/v1/forum/threads/{{threadId}}
Accept: application/json

> {%
  client.test("thread detail 200 + shape", function () {
    client.assert(response.status === 200, "Expected 200 OK, got " + response.status);
    client.assert(response.body.data.id === "{{threadId}}", "Returned thread id must match");
  });
%}
GET {{baseUrl}}/v1/health
Accept: application/json
#    Expected : 201 + created thread and first post in DB
    client.test("server is healthy", function () {
        client.assert(response.status === 200, "Expected 200 OK, got " + response.status);
    });
%}

### 0.1 Register a test user (only needed once; HTTP 409 = username already used is fine)
# @name register
POST {{baseUrl}}/v1/auth/register
Content-Type: application/json

{
  "username": "{{testUsername}}",
  "email": "{{testEmail}}",
  "password": "{{testPassword}}"
}

### 0.2 Login and capture access token (RUN FIRST for authenticated requests)
# @name login
POST {{baseUrl}}/v1/auth/login
Content-Type: application/json

{
  "identifier": "{{testUsername}}",
  "password": "{{testPassword}}"
}

> {%
    client.global.set("accessToken", response.body.access_token);
    client.global.set("refreshToken", response.body.refresh_token);
%}

# ============================================================================
#  1. Forum categories
# ============================================================================

### 1.1 List all forum categories (public)
# @name listCategories
GET {{baseUrl}}/v1/forum/categories
Accept: application/json

> {%
    client.test("list categories 200 + shape", function () {
        client.assert(response.status === 200, "Expected 200 OK, got " + response.status);
        client.assert(Array.isArray(response.body.data), "body.data must be an array");
    });
%}

# ============================================================================
#  2. Threads by category (public, paginated)
# ============================================================================

### 2.1 List threads in a category (default pagination: page=1, limit=20)
GET {{baseUrl}}/v1/forum/categories/{{categoryId}}/threads
Accept: application/json

> {%
    client.test("list threads 200 + shape", function () {
        client.assert(response.status === 200, "Expected 200 OK, got " + response.status);
        client.assert(Array.isArray(response.body.data), "body.data must be an array");
        client.assert(typeof response.body.total === "number", "body.total must be a number");
    });
%}

### 2.2 List threads — explicit pagination page=2&limit=5
GET {{baseUrl}}/v1/forum/categories/{{categoryId}}/threads?page=2&limit=5
Accept: application/json

### 2.3 List threads — limit above max (100) is clamped, still 200 OK
GET {{baseUrl}}/v1/forum/categories/{{categoryId}}/threads?page=1&limit=500
Accept: application/json

### 2.4 List threads — cursor pagination first page
# Use the returned next_cursor for the next request.
GET {{baseUrl}}/v1/forum/categories/{{categoryId}}/threads?cursor=first&limit=20
Accept: application/json

### 2.5 List threads — continue cursor pagination
# Replace {{threadCursor}} with the previous response's next_cursor.
GET {{baseUrl}}/v1/forum/categories/{{categoryId}}/threads?cursor={{threadCursor}}&limit=20
Accept: application/json

### 2.6 List threads — invalid category id (not a UUID) -> 400 INVALID_REQUEST_BODY
GET {{baseUrl}}/v1/forum/categories/not-a-uuid/threads
Accept: application/json

### 2.7 List threads — non-existent category -> 404 FORUM_CATEGORY_NOT_FOUND
GET {{baseUrl}}/v1/forum/categories/00000000-0000-0000-0000-000000000000/threads
Accept: application/json

# ============================================================================
#  3. Posts by thread (public, paginated)
# ============================================================================

### 3.1 List posts in a thread (default pagination)
GET {{baseUrl}}/v1/forum/threads/{{threadId}}/posts
Accept: application/json

> {%
    client.test("list posts 200 + shape", function () {
        client.assert(response.status === 200, "Expected 200 OK, got " + response.status);
        client.assert(Array.isArray(response.body.data), "body.data must be an array");
    });
%}

### 3.2 List posts — explicit pagination page=1&limit=10
GET {{baseUrl}}/v1/forum/threads/{{threadId}}/posts?page=1&limit=10
Accept: application/json

### 3.3 List posts — cursor pagination first page
GET {{baseUrl}}/v1/forum/threads/{{threadId}}/posts?cursor=first&limit=20
Accept: application/json

### 3.4 List posts — invalid thread id (not a UUID) -> 400 INVALID_REQUEST_BODY
GET {{baseUrl}}/v1/forum/threads/not-a-uuid/posts
Accept: application/json

### 3.5 List posts — non-existent thread -> 404 FORUM_THREAD_NOT_FOUND
GET {{baseUrl}}/v1/forum/threads/00000000-0000-0000-0000-000000000000/posts
Accept: application/json

# ============================================================================
#  4. Create thread  (authenticated)
# ============================================================================

### 4.1 Create a thread with first post (valid body)
#    Expected : 201 + created thread/post in DB
POST {{baseUrl}}/v1/forum/threads
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "category_id": "{{categoryId}}",
  "title": "Welcome to OpenCW forum!",
  "body": "This is the opening post of the thread."
}

### 4.2 Create thread — missing Authorization header -> 401 AUTH_HEADER_REQUIRED
POST {{baseUrl}}/v1/forum/threads
Content-Type: application/json

{
  "category_id": "{{categoryId}}",
  "title": "Should not pass",
  "body": "body text"
}

### 4.3 Create thread — malformed Authorization header -> 401 INVALID_AUTH_HEADER_FORMAT
POST {{baseUrl}}/v1/forum/threads
Authorization: this-is-not-bearer-format
Content-Type: application/json

{
  "category_id": "{{categoryId}}",
  "title": "Should not pass",
  "body": "body text"
}

### 4.4 Create thread — invalid (garbage) bearer token -> 401 INVALID_TOKEN
POST {{baseUrl}}/v1/forum/threads
Authorization: Bearer not.a.valid.jwt
Content-Type: application/json

{
  "category_id": "{{categoryId}}",
  "title": "Should not pass",
  "body": "body text"
}

### 4.5 Create thread — title too short (min 3) -> 400 INVALID_REQUEST_BODY
POST {{baseUrl}}/v1/forum/threads
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "category_id": "{{categoryId}}",
  "title": "ab",
  "body": "body text"
}

### 4.6 Create thread — invalid category_id (not a UUID) -> 400 INVALID_REQUEST_BODY
POST {{baseUrl}}/v1/forum/threads
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "category_id": "not-a-uuid",
  "title": "A valid title",
  "body": "body text"
}

### 4.7 Create thread — missing required body -> 400 INVALID_REQUEST_BODY
POST {{baseUrl}}/v1/forum/threads
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "category_id": "{{categoryId}}",
  "title": "A valid title"
}

# ============================================================================
#  5. Create post (authenticated)
# ============================================================================

### 5.1 Create a post in a thread (valid body)
#    Expected : 201 + created post in DB
POST {{baseUrl}}/v1/forum/threads/{{threadId}}/posts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "body": "This is a reply inside the thread."
}

### 5.2 Create a nested reply post (body + parent_id)
#    Expected : 201 + created post in DB
POST {{baseUrl}}/v1/forum/threads/{{threadId}}/posts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "body": "Nested reply to an earlier post.",
  "parent_id": "7c9e6679-7425-40de-944b-e07fc1f90ae7"
}

### 5.3 Create post — missing Authorization header -> 401 AUTH_HEADER_REQUIRED
POST {{baseUrl}}/v1/forum/threads/{{threadId}}/posts
Content-Type: application/json

{
  "body": "Should not pass"
}

### 5.4 Create post — invalid thread id (not a UUID) -> 400 INVALID_REQUEST_BODY
POST {{baseUrl}}/v1/forum/threads/not-a-uuid/posts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "body": "Should not pass"
}

### 5.5 Create post — non-existent thread -> 404 FORUM_THREAD_NOT_FOUND
POST {{baseUrl}}/v1/forum/threads/00000000-0000-0000-0000-000000000000/posts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "body": "Should not pass"
}

### 5.6 Create post — empty body (required, min 1) -> 400 INVALID_REQUEST_BODY
POST {{baseUrl}}/v1/forum/threads/{{threadId}}/posts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "body": ""
}
